#!/usr/bin/env node

"use strict";

const { spawnSync } = require("node:child_process");
const { createHash } = require("node:crypto");
const fs = require("node:fs");
const os = require("node:os");
const path = require("node:path");

const TARGET_ANALYZER = "risk-session-review";
const SOURCE_ANALYZERS = [
  "code-intent",
  "agent-file-triage",
  "rust-blast-radius",
  "rust-test-coverage-intent",
];
const SOURCE_FIELDS = {
  "code-intent": ["purpose", "parent_keywords", "mechanism"],
  "agent-file-triage": [
    "triage_summary",
    "surface_area",
    "open_when",
    "answers_questions",
    "change_risk",
    "change_risk_reason",
  ],
  "rust-blast-radius": [
    "purpose",
    "surface_area",
    "role",
    "dependents_count",
    "dependencies_count",
    "coupling_risk",
    "has_public_api",
    "change_risk",
  ],
  "rust-test-coverage-intent": [
    "has_test",
    "test_role",
    "tested_behavior",
    "risk_covered",
    "add_test_guidance",
    "summary",
  ],
};

function main() {
  const flags = parseFlags(process.argv.slice(2));
  if (flags.help) {
    printHelp();
    return;
  }
  if (flags.selfTest) {
    runSelfTest();
    return;
  }

  const repoRoot = findRepoRoot(process.cwd());
  const context = resolveRepositoryContext(repoRoot);
  const recordsByAnalyzer = new Map();

  for (const analyzer of SOURCE_ANALYZERS) {
    process.stderr.write(`[gsc] Reading ${analyzer} Brain...\n`);
    recordsByAnalyzer.set(analyzer, fetchBrain(repoRoot, analyzer, false));
  }

  const lessons = loadRepositoryLessons(repoRoot);
  const records = buildRecords(recordsByAnalyzer, lessons);
  const outputPath = path.resolve(
    flags.output || path.join(os.tmpdir(), "gsc-risk-session-review.jsonl"),
  );
  writeJSONL(outputPath, records);
  process.stderr.write(`[risk-session-review] Generated ${records.length} record(s)\n`);
  process.stderr.write(`[risk-session-review] Output: ${outputPath}\n`);
  const manifestPath = path.join(
    repoRoot,
    ".gitsense",
    "manifests",
    `${TARGET_ANALYZER}.json`,
  );
  const manifestChanged = writeManifest(manifestPath, buildManifest(records, context));
  createLocalBrain(repoRoot, manifestPath, manifestChanged);
}

function parseFlags(args) {
  const flags = {
    output: "",
    help: false,
    selfTest: false,
  };

  for (let index = 0; index < args.length; index += 1) {
    const arg = args[index];
    switch (arg) {
      case "--output": {
        const value = args[index + 1];
        if (!value || value.startsWith("--")) {
          throw new Error(`${arg} requires a value`);
        }
        flags[arg.slice(2)] = value;
        index += 1;
        break;
      }
      case "--self-test":
        flags.selfTest = true;
        break;
      case "--help":
      case "-h":
        flags.help = true;
        break;
      default:
        throw new Error(`Unknown argument: ${arg}`);
    }
  }

  return flags;
}

function printHelp() {
  process.stdout.write("Build deterministic risk-session-review metadata.\n\n");
  process.stdout.write("Usage:\n");
  process.stdout.write("  .gitsense/bin/build-risk-session-review [flags]\n\n");
  process.stdout.write("Flags:\n");
  process.stdout.write("  --output <path>   JSONL output path (default: system temp directory)\n");
  process.stdout.write("                    The local Brain is written to .gitsense/risk-session-review.db\n");
  process.stdout.write("  --self-test       Run deterministic formatter checks\n");
  process.stdout.write("  -h, --help        Show this help\n");
}

function findRepoRoot(startDir) {
  let current = path.resolve(startDir);
  while (true) {
    if (fs.existsSync(path.join(current, ".git"))) {
      return current;
    }
    const parent = path.dirname(current);
    if (parent === current) {
      throw new Error("Could not find a Git repository from the current directory");
    }
    current = parent;
  }
}

function resolveRepositoryContext(repoRoot) {
  const manifestPath = path.join(repoRoot, ".gitsense", "manifests", "code-intent.json");
  const context = {};
  if (fs.existsSync(manifestPath)) {
    const manifest = JSON.parse(fs.readFileSync(manifestPath, "utf8"));
    const repositoryName = manifest.repositories?.[0]?.name;
    const branchName = manifest.branches?.[0]?.name;
    if (typeof repositoryName === "string" && repositoryName.includes("/")) {
      const separator = repositoryName.indexOf("/");
      context.owner ||= repositoryName.slice(0, separator);
      context.repo ||= repositoryName.slice(separator + 1);
    }
    if (typeof branchName === "string") {
      context.branch ||= branchName;
    }
  }

  if (!context.owner || !context.repo || !context.branch) {
    throw new Error(
      "Could not determine repository context from .gitsense/manifests/code-intent.json.",
    );
  }
  return context;
}

function fetchBrain(repoRoot, analyzer, tolerateMissing) {
  const fields = SOURCE_FIELDS[analyzer];
  if (!fields) {
    throw new Error(`No local Brain field list configured for ${analyzer}`);
  }

  const args = [
    "query",
    "--db",
    analyzer,
    "--glob",
    "**/*",
    "--fields",
    fields.join(","),
    "--format",
    "json",
    "--quiet",
  ];
  const result = spawnSync("gsc", args, {
    cwd: repoRoot,
    encoding: "utf8",
    maxBuffer: 64 * 1024 * 1024,
  });

  if (result.error) {
    throw new Error(`Failed to run gsc: ${result.error.message}`);
  }
  if (result.status !== 0) {
    if (tolerateMissing) {
      return new Map();
    }
    const detail = result.stderr.trim() || result.stdout.trim() || `exit ${result.status}`;
    throw new Error(`Failed to read local ${analyzer} Brain: ${detail}`);
  }

  const parsed = JSON.parse(result.stdout);
  const files = parsed.results === null ? [] : parsed.results;
  if (!Array.isArray(files)) {
    throw new Error(`Invalid ${analyzer} Brain response: expected a results array`);
  }

  const records = new Map();
  for (const resultRecord of files) {
    if (resultRecord && typeof resultRecord.file_path === "string") {
      const metadata = { ...(resultRecord.metadata || {}) };
      if (Number.isInteger(resultRecord.chat_id)) {
        metadata.__source_chat_id = resultRecord.chat_id;
      }
      records.set(normalizePath(resultRecord.file_path), metadata);
    }
  }
  process.stderr.write(`[gsc] Found ${records.size} ${analyzer} Brain record(s)\n`);
  return records;
}

function buildRecords(recordsByAnalyzer, lessons = []) {
  const filePaths = new Set();
  for (const records of recordsByAnalyzer.values()) {
    for (const filePath of records.keys()) {
      filePaths.add(filePath);
    }
  }
  for (const lesson of lessons) {
    for (const filePath of [
      ...stringArray(lesson.applies_to?.files),
      ...stringArray(lesson.applies_to?.linked_files),
    ]) {
      filePaths.add(normalizePath(filePath));
    }
  }

  return [...filePaths]
    .sort((left, right) => left.localeCompare(right))
    .map((filePath) => buildRecord(filePath, recordsByAnalyzer, lessons));
}

function buildRecord(filePath, recordsByAnalyzer, lessons = []) {
  const codeIntent = recordsByAnalyzer.get("code-intent")?.get(filePath) || {};
  const triage = recordsByAnalyzer.get("agent-file-triage")?.get(filePath) || {};
  const blast = recordsByAnalyzer.get("rust-blast-radius")?.get(filePath) || {};
  const tests = recordsByAnalyzer.get("rust-test-coverage-intent")?.get(filePath) || {};
  const relatedLessons = findRelatedLessons(filePath, lessons);

  const sourceRecords = {
    "agent-file-triage": selectFields(triage, [
      "triage_summary",
      "surface_area",
      "open_when",
      "answers_questions",
      "change_risk",
      "change_risk_reason",
    ]),
    "code-intent": selectFields(codeIntent, ["purpose", "parent_keywords", "mechanism"]),
    "rust-blast-radius": selectFields(blast, [
      "purpose",
      "surface_area",
      "role",
      "dependents_count",
      "dependencies_count",
      "coupling_risk",
      "has_public_api",
      "change_risk",
    ]),
    "rust-test-coverage-intent": selectFields(tests, [
      "has_test",
      "test_role",
      "tested_behavior",
      "risk_covered",
      "add_test_guidance",
      "summary",
    ]),
    "repository-lessons": relatedLessons.map(lesson => ({
      id: lesson.id,
      updated_at: lesson.updated_at || "",
      summary: lesson.summary,
      details: lesson.details || "",
      topic: lesson.topic || "",
      review_checks: stringArray(lesson.review_checks),
      files: stringArray(lesson.applies_to?.files),
      linked_files: stringArray(lesson.applies_to?.linked_files),
    })),
  };

  const sourceAnalyzers = Object.entries(sourceRecords)
    .filter(([, record]) => Object.keys(record).length > 0)
    .map(([analyzer]) => analyzer)
    .sort();
  const sourceFingerprint = sha256(stableStringify(sourceRecords));

  return {
    file_path: filePath,
    chat_id: firstInteger(codeIntent.__source_chat_id, triage.__source_chat_id, blast.__source_chat_id, tests.__source_chat_id),
    fields: {
      read_items: buildReadItems(filePath, codeIntent, triage, blast, relatedLessons),
      edit_items: buildEditItems(filePath, codeIntent, triage, blast, tests, relatedLessons),
      write_items: buildWriteItems(filePath, codeIntent, triage, blast, tests, relatedLessons),
      source_analyzers: sourceAnalyzers,
      source_fingerprint: sourceFingerprint,
    },
  };
}

function buildReadItems(filePath, codeIntent, triage, blast, relatedLessons = []) {
  const context = buildFileContextItem(filePath, codeIntent, triage, blast);
  return [
    ...(context ? [context] : []),
    ...buildLessonItems(relatedLessons),
  ];
}

function buildEditItems(filePath, codeIntent, triage, blast, tests, relatedLessons = []) {
  const items = [];
  const context = buildFileContextItem(filePath, codeIntent, triage, blast);
  if (context) {
    items.push(context);
  }

  const risk = highestRisk(triage.change_risk, blast.change_risk, blast.coupling_risk);
  const riskReason = firstString(triage.change_risk_reason);
  if (risk || riskReason) {
    const details = [];
    if (riskReason) {
      details.push(markdownText(riskReason));
    }
    if (blast.coupling_risk) {
      details.push(`**Coupling risk:** ${markdownText(titleCase(blast.coupling_risk))}`);
    }
    items.push(reviewItem(
      "Change risk",
      `change-risk:${risk || "unspecified"}`,
      risk ? `${titleCase(risk)}-risk change` : "Change risk needs review",
      risk
        ? `Review the impact of this ${titleCase(risk)}-risk change before continuing.`
        : "Review the visible change impact before continuing.",
      details.join("\n\n") || "Review the visible change impact before continuing.",
    ));
  }

  const dependents = integerValue(blast.dependents_count);
  if (blast.has_public_api === true) {
    const details = [];
    const role = firstString(blast.role);
    if (role) {
      details.push(`**Role:** ${markdownText(titleCase(role))}`);
    }
    if (dependents !== null) {
      details.push(`**Known dependents:** ${dependents}`);
    }
    items.push(reviewItem(
      "API and dependencies",
      "public-api",
      "Public API may be affected",
      "Check callers and compatibility before changing this public API.",
      details.join("\n\n") || "This file exposes a public API.",
    ));
  } else if (dependents !== null && dependents > 0) {
    items.push(reviewItem(
      "API and dependencies",
      `known-dependents:${dependents}`,
      `${dependents} known dependent${dependents === 1 ? "" : "s"}`,
      `Check the ${dependents} known dependent${dependents === 1 ? "" : "s"} before changing this file.`,
      `Changes to this file may affect **${dependents}** known dependent${dependents === 1 ? "" : "s"}.`,
    ));
  }

  const coverage = [];
  const testSummary = firstString(tests.summary);
  if (testSummary) {
    coverage.push(markdownText(testSummary));
  }
  const risksCovered = stringArray(tests.risk_covered).slice(0, 4);
  if (risksCovered.length > 0) {
    coverage.push(bulletList(risksCovered.map(titleCase)));
  }
  if (coverage.length > 0) {
    items.push(reviewItem(
      "Tests and safeguards",
      "regression-coverage",
      "Regression coverage exists",
      "Check that existing regression coverage still protects the affected behavior.",
      coverage.join("\n\n"),
    ));
  }

  const testGuidance = firstString(tests.add_test_guidance);
  if (testGuidance) {
    const title = compactTitle(testGuidance, "Add regression coverage");
    items.push(reviewItem(
      "Tests and safeguards",
      `test-guidance:${sha256(title.toLowerCase()).slice(0, 12)}`,
      title,
      "Confirm that the recommended regression coverage is present.",
      markdownText(testGuidance),
    ));
  }
  return [...items, ...buildLessonItems(relatedLessons)];
}

function buildWriteItems(filePath, codeIntent, triage, blast, tests, relatedLessons = []) {
  return [
    reviewItem(
      "Write operation",
      "create-or-replace-file",
      "New or replaced file",
      "Confirm whether this complete write creates a new file or replaces existing contents.",
      "A write operation supplies the complete file contents instead of applying a targeted edit. Confirm whether it creates a new file or intentionally replaces the existing contents.",
    ),
    ...buildEditItems(filePath, codeIntent, triage, blast, tests, relatedLessons),
  ];
}

function loadRepositoryLessons(repoRoot) {
  const recordsPath = path.join(repoRoot, ".gitsense", "lessons", "records.jsonl");
  if (!fs.existsSync(recordsPath)) {
    return [];
  }

  const lessons = [];
  const records = parseJSONRecords(fs.readFileSync(recordsPath, "utf8"), recordsPath);
  for (const lesson of records) {
    if (lesson && typeof lesson.id === "string" && firstString(lesson.summary)) {
      lessons.push(lesson);
    }
  }
  return lessons;
}

function parseJSONRecords(text, recordsPath) {
  const records = [];
  let recordStart = -1;
  let objectDepth = 0;
  let inString = false;
  let escaped = false;

  for (let index = 0; index < text.length; index += 1) {
    const character = text[index];

    if (recordStart === -1) {
      if (/\s/.test(character) || character === "\uFEFF") {
        continue;
      }
      if (character !== "{") {
        throw new Error(
          `Invalid lesson JSON at ${recordsPath}:${lineNumberAt(text, index)}: expected a JSON object`,
        );
      }
      recordStart = index;
      objectDepth = 1;
      continue;
    }

    if (inString) {
      if (escaped) {
        escaped = false;
      } else if (character === "\\") {
        escaped = true;
      } else if (character === '"') {
        inString = false;
      }
      continue;
    }

    if (character === '"') {
      inString = true;
    } else if (character === "{") {
      objectDepth += 1;
    } else if (character === "}") {
      objectDepth -= 1;
      if (objectDepth === 0) {
        const rawRecord = text.slice(recordStart, index + 1);
        try {
          records.push(JSON.parse(rawRecord));
        } catch (error) {
          throw new Error(
            `Invalid lesson JSON at ${recordsPath}:${lineNumberAt(text, recordStart)}: ${error.message}`,
          );
        }
        recordStart = -1;
      }
    }
  }

  if (recordStart !== -1) {
    throw new Error(
      `Invalid lesson JSON at ${recordsPath}:${lineNumberAt(text, recordStart)}: unterminated JSON object`,
    );
  }
  return records;
}

function lineNumberAt(text, index) {
  return text.slice(0, index).split(/\r?\n/).length;
}

function findRelatedLessons(filePath, lessons) {
  const matches = new Map();
  for (const lesson of lessons) {
    const directFiles = new Set(stringArray(lesson.applies_to?.files).map(normalizePath));
    const linkedFiles = new Set(stringArray(lesson.applies_to?.linked_files).map(normalizePath));
    const appliesDirectly = directFiles.has(filePath);
    const appliesAsLinked = linkedFiles.has(filePath);
    if (!appliesDirectly && !appliesAsLinked) continue;

    matches.set(lesson.id, lesson);
  }
  return [...matches.values()].sort((left, right) => left.id.localeCompare(right.id));
}

function buildLessonItems(lessons) {
  return lessons.map((lesson) => {
    const details = [];
    const topic = firstString(lesson.topic);
    if (topic) {
      details.push(`**Topic:** ${markdownText(titleCase(topic))}`);
    }
    const importance = firstString(lesson.importance);
    if (importance) {
      details.push(`**Importance:** ${markdownText(titleCase(importance))}`);
    }
    const lessonDetails = firstString(lesson.details);
    if (lessonDetails) {
      details.push(`### Lesson\n\n${markdownText(lessonDetails)}`);
    }
    const reviewChecks = stringArray(lesson.review_checks).slice(0, 6);
    if (reviewChecks.length > 0) {
      details.push(`### Review checks\n\n${bulletList(reviewChecks)}`);
    }
    return reviewItem(
      "Repository memory",
      `lesson:${lesson.id}`,
      `Related lesson: ${compactTitle(lesson.summary, "Repository lesson")}`,
      "Check this related repository lesson before changing the file.",
      details.join("\n\n"),
    );
  });
}

function buildFileContextItem(filePath, codeIntent, triage, blast) {
  const sections = [];
  const purpose = firstString(triage.triage_summary, codeIntent.purpose, blast.purpose);
  if (purpose) {
    sections.push(`### What this file does\n\n${markdownText(purpose)}`);
  }

  const where = [];
  pushLabel(where, "Surface", firstString(triage.surface_area, blast.surface_area));
  pushLabel(where, "Role", firstString(blast.role));
  pushLabel(where, "Mechanism", firstString(codeIntent.mechanism));
  const topics = stringArray(codeIntent.parent_keywords).slice(0, 4);
  if (topics.length > 0) {
    pushLabel(where, "Areas", topics.map(titleCase).join(", "));
  }
  if (where.length > 0) {
    sections.push(`### Where it fits\n\n${where.join("\n")}`);
  }

  const openWhen = stringArray(triage.open_when).slice(0, 3);
  if (openWhen.length > 0) {
    sections.push(`### Useful when\n\n${bulletList(openWhen)}`);
  }
  if (sections.length === 0) {
    return null;
  }
  return reviewItem(
    "File context",
    `file-context:${sha256(filePath).slice(0, 12)}`,
    compactTitle(purpose, "Understand this file's role"),
    "Understand this file's role before judging the change.",
    sections.join("\n\n"),
  );
}

function reviewItem(group, key, title, shortMarkdown, longMarkdown) {
  return {
    group,
    key,
    title,
    short_markdown: shortMarkdown,
    long_markdown: longMarkdown,
    // Keep the legacy field populated for existing Brain consumers.
    markdown: longMarkdown,
  };
}

function selectFields(record, names) {
  const selected = {};
  for (const name of names) {
    if (record[name] !== undefined && record[name] !== null && record[name] !== "N/A") {
      selected[name] = normalizeValue(record[name]);
    }
  }
  return selected;
}

function normalizeValue(value) {
  if (typeof value === "string") {
    const trimmed = value.trim();
    if ((trimmed.startsWith("[") && trimmed.endsWith("]")) || (trimmed.startsWith("{") && trimmed.endsWith("}"))) {
      try {
        return normalizeValue(JSON.parse(trimmed));
      } catch {
        return value;
      }
    }
    return value;
  }
  if (Array.isArray(value)) {
    return value.map(normalizeValue);
  }
  if (value && typeof value === "object") {
    return Object.fromEntries(
      Object.entries(value)
        .sort(([left], [right]) => left.localeCompare(right))
        .map(([key, item]) => [key, normalizeValue(item)]),
    );
  }
  return value;
}

function stringArray(value) {
  const normalized = normalizeValue(value);
  if (!Array.isArray(normalized)) {
    return [];
  }
  return [...new Set(normalized.filter((item) => typeof item === "string").map(cleanText).filter(Boolean))];
}

function firstString(...values) {
  for (const value of values) {
    if (typeof value === "string") {
      const cleaned = cleanText(value);
      if (cleaned && cleaned !== "N/A") {
        return cleaned;
      }
    }
  }
  return "";
}

function cleanText(value) {
  return String(value).replace(/\s+/g, " ").trim();
}

function markdownText(value) {
  return cleanText(value).replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");
}

function compactTitle(value, fallback) {
  const cleaned = cleanText(value || fallback).replace(/[.!?]+$/, "");
  if (cleaned.length <= 72) {
    return cleaned;
  }
  return `${cleaned.slice(0, 69).trimEnd()}…`;
}

function bulletList(values) {
  return values.map((value) => `- ${markdownText(value)}`).join("\n");
}

function pushLabel(lines, label, value) {
  if (value) {
    lines.push(`- **${label}:** ${markdownText(value)}`);
  }
}

function titleCase(value) {
  return cleanText(value)
    .replace(/[-_]+/g, " ")
    .replace(/\b\w/g, (character) => character.toUpperCase());
}

function integerValue(value) {
  return Number.isInteger(value) ? value : null;
}

function firstInteger(...values) {
  return values.find((value) => Number.isInteger(value)) ?? null;
}

function highestRisk(...values) {
  const rank = { low: 1, medium: 2, high: 3, critical: 4 };
  return values
    .filter((value) => typeof value === "string" && rank[value.toLowerCase()])
    .map((value) => value.toLowerCase())
    .sort((left, right) => rank[right] - rank[left])[0] || "";
}

function stableStringify(value) {
  if (Array.isArray(value)) {
    return `[${value.map(stableStringify).join(",")}]`;
  }
  if (value && typeof value === "object") {
    const entries = Object.entries(value).sort(([left], [right]) => left.localeCompare(right));
    return `{${entries.map(([key, item]) => `${JSON.stringify(key)}:${stableStringify(item)}`).join(",")}}`;
  }
  return JSON.stringify(value);
}

function sha256(value) {
  return createHash("sha256").update(value).digest("hex");
}

function normalizePath(filePath) {
  return filePath.replaceAll("\\", "/").replace(/^\.\//, "");
}

function writeJSONL(outputPath, records) {
  fs.mkdirSync(path.dirname(outputPath), { recursive: true });
  const body = records.map((record) => JSON.stringify(record)).join("\n");
  fs.writeFileSync(outputPath, body ? `${body}\n` : "", "utf8");
}

const TARGET_FIELD_DEFINITIONS = [
  ["file_path", "string", "Repository-relative target file path."],
  ["file_name", "string", "Target filename including extension."],
  ["file_extension", "string", "Target file extension without a leading dot."],
  ["read_items", "array", "Review items surfaced for file-read events."],
  ["edit_items", "array", "Review items surfaced for targeted-edit events."],
  ["write_items", "array", "Review items surfaced for complete-file write events."],
  ["source_analyzers", "array", "Source Analyzers that contributed metadata."],
  ["source_fingerprint", "string", "SHA-256 fingerprint of the source metadata."],
];

function buildManifest(records, context) {
  const analyzerRef = "A0";
  const fieldRefs = new Map(
    TARGET_FIELD_DEFINITIONS.map(([name], index) => [name, `F${index}`]),
  );
  const fields = TARGET_FIELD_DEFINITIONS.map(([name, type, description], index) => ({
    ref: `F${index}`,
    name,
    type,
    display_name: titleCase(name),
    description,
    analyzer_ref: analyzerRef,
  }));

  return {
    schema_version: "1.0",
    generated_at: new Date().toISOString(),
    manifest: {
      name: `${context.repo} - Risk Session Review`,
      database_name: TARGET_ANALYZER,
      description: "Deterministic review items composed from local repository Brains and lessons.",
      tags: ["deterministic", "session-review", "risk-session-review"],
    },
    repositories: [{ ref: "R0", name: `${context.owner}/${context.repo}` }],
    branches: [{ ref: "B0", name: context.branch }],
    analyzers: [{
      ref: analyzerRef,
      id: "risk-session-review::file-content::default",
      name: "risk-session-review::file-content::default",
      description: "Stores deterministic change-risk review items for file activity.",
      version: "1.1.0",
    }],
    fields,
    data: records.map((record, index) => {
      const extension = path.extname(record.file_path).replace(/^\./, "");
      const values = {
        file_path: record.file_path,
        file_name: path.basename(record.file_path),
        file_extension: extension,
        ...record.fields,
      };
      return {
        repo_ref: "R0",
        branch_ref: "B0",
        chat_id: Number.isInteger(record.chat_id) ? record.chat_id : index + 1,
        file_path: record.file_path,
        language: extension,
        fields: Object.fromEntries(
          TARGET_FIELD_DEFINITIONS.map(([name]) => [fieldRefs.get(name), values[name]]),
        ),
      };
    }),
  };
}

function writeManifest(manifestPath, manifest) {
  fs.mkdirSync(path.dirname(manifestPath), { recursive: true });
  const body = `${JSON.stringify(manifest, null, 2)}\n`;
  if (fs.existsSync(manifestPath)) {
    const previous = fs.readFileSync(manifestPath, "utf8");
    try {
      const previousManifest = JSON.parse(previous);
      const comparablePrevious = { ...previousManifest, generated_at: "" };
      const comparableCurrent = { ...manifest, generated_at: "" };
      if (stableStringify(comparablePrevious) === stableStringify(comparableCurrent)) {
        return false;
      }
    } catch {
      // Rewrite an invalid or incomplete generated manifest.
    }
  }
  fs.writeFileSync(manifestPath, body, "utf8");
  process.stderr.write(`[risk-session-review] Manifest: ${manifestPath}\n`);
  return true;
}

function createLocalBrain(repoRoot, manifestPath, manifestChanged) {
  const databasePath = path.join(repoRoot, ".gitsense", `${TARGET_ANALYZER}.db`);
  if (!manifestChanged && fs.existsSync(databasePath)) {
    process.stderr.write(`[risk-session-review] Local Brain is up to date: ${databasePath}\n`);
    return;
  }

  const args = ["manifest", "import", manifestPath];
  if (fs.existsSync(databasePath)) {
    args.push("--force");
  }
  const result = spawnSync("gsc", args, {
    cwd: repoRoot,
    encoding: "utf8",
    stdio: ["ignore", "inherit", "inherit"],
  });
  if (result.error) {
    throw new Error(`Failed to run gsc: ${result.error.message}`);
  }
  if (result.status !== 0) {
    throw new Error(`Failed to create local ${TARGET_ANALYZER} Brain`);
  }
  process.stderr.write(`[risk-session-review] Local Brain ready: ${databasePath}\n`);
}

function runSelfTest() {
  const records = new Map([
    [
      "code-intent",
      new Map([
        [
          "src/example.rs",
          {
            purpose: "Modify this file to change JSON output.",
            parent_keywords: ["serialization", "public-api"],
            mechanism: "json-lines",
          },
        ],
      ]),
    ],
    [
      "agent-file-triage",
      new Map([
        [
          "src/example.rs",
          {
            triage_summary: "Implements the public JSON Lines output format.",
            surface_area: "primary-implementation",
            open_when: ["Changing JSON output", "Debugging binary encoding"],
            change_risk: "high",
            change_risk_reason: "Downstream tools parse this output.",
          },
        ],
      ]),
    ],
    [
      "rust-blast-radius",
      new Map([
        [
          "src/example.rs",
          {
            role: "defines-api",
            dependents_count: 3,
            coupling_risk: "high",
            has_public_api: true,
          },
        ],
      ]),
    ],
    [
      "rust-test-coverage-intent",
      new Map([
        [
          "src/example.rs",
          {
            summary: "Tests cover JSON events and binary detection.",
            risk_covered: ["json-format-regression", "binary-detection-regression"],
            add_test_guidance: "Add output compatibility tests here.",
          },
        ],
      ]),
    ],
  ]);
  const lessons = [
    {
      id: "lsn_example",
      summary: "Keep JSON output compatible with downstream tools.",
      details: "Consumers parse this output as a stable contract.",
      topic: "serialization",
      importance: "high",
      review_checks: ["Run the compatibility tests."],
      applies_to: {
        files: ["src/example.rs"],
        linked_files: ["src/linked.rs"],
      },
    },
  ];
  const parsedLessons = parseJSONRecords(
    '{\n  "id": "lsn_formatted",\n  "summary": "Formatted lesson"\n}\n{"id":"lsn_compact","summary":"Compact lesson"}',
    "/tmp/lessons/records.jsonl",
  );
  assert(parsedLessons.length === 2, "formatted and compact lesson records");
  const builtRecords = buildRecords(records, lessons);
  const [record] = builtRecords;
  assert(record.file_path === "src/example.rs", "file path");
  assert(record.fields.read_items.length === 2, "classified read item plus repository lesson");
  assert(record.fields.read_items[0].group === "File context", "read group");
  assert(record.fields.read_items[0].markdown.includes("### Useful when"), "read guidance");
  assert(record.fields.read_items[0].long_markdown === record.fields.read_items[0].markdown, "legacy markdown alias");
  assert(record.fields.read_items[0].short_markdown === "Understand this file's role before judging the change.", "short read guidance");
  assert(record.fields.read_items.some((item) => item.group === "Repository memory"), "read lesson");
  assert(record.fields.edit_items.some((item) => item.title === "High-risk change"), "risk item");
  assert(record.fields.edit_items.some((item) => item.title === "Public API may be affected"), "public API item");
  assert(record.fields.edit_items.some((item) => item.title === "Regression coverage exists"), "coverage item");
  assert(record.fields.edit_items.some((item) => item.title === "Add output compatibility tests here"), "test guidance item");
  assert(record.fields.edit_items.every((item) => item.group && item.key && item.title && item.short_markdown && item.long_markdown && item.markdown), "item contract");
  assert(record.fields.write_items[0].title === "New or replaced file", "write classification item");
  assert(record.fields.write_items.some((item) => item.title === "High-risk change"), "write risk item");
  assert(record.fields.write_items.some((item) => item.key === "lesson:lsn_example"), "write lesson");
  assert(record.fields.write_items.every((item) => item.group && item.key && item.title && item.short_markdown && item.long_markdown && item.markdown), "write item contract");
  assert(record.fields.source_fingerprint.length === 64, "source fingerprint");
  assert(builtRecords.length === 2, "lesson linked file record");
  assert(builtRecords[1].fields.read_items[0].key === "lesson:lsn_example", "linked lesson item");
  process.stdout.write("risk-session-review self-test passed\n");
}

function assert(condition, label) {
  if (!condition) {
    throw new Error(`Self-test failed: ${label}`);
  }
}

try {
  main();
} catch (error) {
  process.stderr.write(`${error instanceof Error ? error.message : String(error)}\n`);
  process.exitCode = 1;
}
