#!/usr/bin/env node

"use strict";

const { spawnSync } = require("node:child_process");
const { createHash } = require("node:crypto");
const fs = require("node:fs");
const os = require("node:os");
const path = require("node:path");

const TARGET_ANALYZER = "session-review";
const SOURCE_ANALYZERS = [
  "code-intent",
  "agent-file-triage",
  "rust-blast-radius",
  "rust-test-coverage-intent",
];

function main() {
  const flags = parseFlags(process.argv.slice(2));
  if (flags.help) {
    printHelp();
    return;
  }
  if (flags.selfTest) {
    runSelfTest();
    return;
  }

  const repoRoot = findRepoRoot(process.cwd());
  const context = resolveRepositoryContext(repoRoot, flags);
  const recordsByAnalyzer = new Map();

  for (const analyzer of SOURCE_ANALYZERS) {
    process.stderr.write(`[gsc] Reading ${analyzer} analysis...\n`);
    recordsByAnalyzer.set(analyzer, fetchAnalysis(repoRoot, analyzer, context, false));
  }

  const records = buildRecords(recordsByAnalyzer);
  const outputPath = path.resolve(
    flags.output || path.join(os.tmpdir(), "gsc-session-review.jsonl"),
  );
  writeJSONL(outputPath, records);
  process.stderr.write(`[session-review] Generated ${records.length} record(s)\n`);
  process.stderr.write(`[session-review] Output: ${outputPath}\n`);

  if (!flags.import) {
    process.stderr.write("[session-review] Review the JSONL, then rerun with --import\n");
    return;
  }

  const existing = fetchAnalysis(repoRoot, TARGET_ANALYZER, context, true);
  const changed = filterChangedRecords(records, existing);
  process.stderr.write(
    `[session-review] Change check: new=${changed.newCount}, changed=${changed.changedCount}, unchanged=${changed.unchangedCount}\n`,
  );

  if (changed.records.length === 0) {
    process.stderr.write("[session-review] No metadata changes detected; skipping import\n");
    return;
  }

  const importPath =
    changed.records.length === records.length
      ? outputPath
      : path.join(os.tmpdir(), "gsc-session-review-changed.jsonl");
  if (importPath !== outputPath) {
    writeJSONL(importPath, changed.records);
    process.stderr.write(`[session-review] Changed output: ${importPath}\n`);
  }

  runAnalysisSet(repoRoot, importPath, context, flags);
}

function parseFlags(args) {
  const flags = {
    owner: "",
    repo: "",
    branch: "",
    output: "",
    import: false,
    dryRun: false,
    force: false,
    help: false,
    selfTest: false,
  };

  for (let index = 0; index < args.length; index += 1) {
    const arg = args[index];
    switch (arg) {
      case "--owner":
      case "--repo":
      case "--branch":
      case "--output": {
        const value = args[index + 1];
        if (!value || value.startsWith("--")) {
          throw new Error(`${arg} requires a value`);
        }
        flags[arg.slice(2)] = value;
        index += 1;
        break;
      }
      case "--import":
        flags.import = true;
        break;
      case "--dry-run":
        flags.dryRun = true;
        break;
      case "--force":
        flags.force = true;
        break;
      case "--self-test":
        flags.selfTest = true;
        break;
      case "--help":
      case "-h":
        flags.help = true;
        break;
      default:
        throw new Error(`Unknown argument: ${arg}`);
    }
  }

  if (flags.dryRun && !flags.import) {
    throw new Error("--dry-run requires --import");
  }
  if (flags.force && !flags.import) {
    throw new Error("--force requires --import");
  }
  return flags;
}

function printHelp() {
  process.stdout.write("Build deterministic human-facing session review metadata.\n\n");
  process.stdout.write("Usage:\n");
  process.stdout.write("  .gitsense/bin/build-session-review [flags]\n\n");
  process.stdout.write("Flags:\n");
  process.stdout.write("  --owner <name>    GitSense Chat repository owner\n");
  process.stdout.write("  --repo <name>     GitSense Chat repository name\n");
  process.stdout.write("  --branch <name>   GitSense Chat branch name\n");
  process.stdout.write("  --output <path>   JSONL output path (default: system temp directory)\n");
  process.stdout.write("  --import          Populate session-review with changed records\n");
  process.stdout.write("  --dry-run         Validate gsc app analysis set without writing\n");
  process.stdout.write("  --force           Overwrite existing changed records\n");
  process.stdout.write("  --self-test       Run deterministic formatter checks\n");
  process.stdout.write("  -h, --help        Show this help\n");
}

function findRepoRoot(startDir) {
  let current = path.resolve(startDir);
  while (true) {
    if (fs.existsSync(path.join(current, ".git"))) {
      return current;
    }
    const parent = path.dirname(current);
    if (parent === current) {
      throw new Error("Could not find a Git repository from the current directory");
    }
    current = parent;
  }
}

function resolveRepositoryContext(repoRoot, flags) {
  const context = {
    owner: flags.owner,
    repo: flags.repo,
    branch: flags.branch,
  };
  if (context.owner && context.repo && context.branch) {
    return context;
  }

  const manifestPath = path.join(repoRoot, ".gitsense", "manifests", "code-intent.json");
  if (fs.existsSync(manifestPath)) {
    const manifest = JSON.parse(fs.readFileSync(manifestPath, "utf8"));
    const repositoryName = manifest.repositories?.[0]?.name;
    const branchName = manifest.branches?.[0]?.name;
    if (typeof repositoryName === "string" && repositoryName.includes("/")) {
      const separator = repositoryName.indexOf("/");
      context.owner ||= repositoryName.slice(0, separator);
      context.repo ||= repositoryName.slice(separator + 1);
    }
    if (typeof branchName === "string") {
      context.branch ||= branchName;
    }
  }

  if (!context.owner || !context.repo || !context.branch) {
    throw new Error(
      "Could not determine GitSense Chat repository context. Provide --owner, --repo, and --branch.",
    );
  }
  return context;
}

function fetchAnalysis(repoRoot, analyzer, context, tolerateMissing) {
  const args = [
    "app",
    "analysis",
    "get",
    "--analyzer",
    analyzer,
    "--list",
    "--format",
    "json",
    ...contextArgs(context),
  ];
  const result = spawnSync("gsc", args, {
    cwd: repoRoot,
    encoding: "utf8",
    maxBuffer: 64 * 1024 * 1024,
  });

  if (result.error) {
    throw new Error(`Failed to run gsc: ${result.error.message}`);
  }
  if (result.status !== 0) {
    if (tolerateMissing) {
      return new Map();
    }
    const detail = result.stderr.trim() || result.stdout.trim() || `exit ${result.status}`;
    throw new Error(`Failed to read ${analyzer} analysis: ${detail}`);
  }

  const parsed = JSON.parse(result.stdout);
  if (!Array.isArray(parsed.files)) {
    throw new Error(`Invalid ${analyzer} response: expected a files array`);
  }

  const records = new Map();
  for (const record of parsed.files) {
    if (record && typeof record.file_path === "string") {
      records.set(normalizePath(record.file_path), record);
    }
  }
  process.stderr.write(`[gsc] Found ${records.size} ${analyzer} record(s)\n`);
  return records;
}

function buildRecords(recordsByAnalyzer) {
  const filePaths = new Set();
  for (const records of recordsByAnalyzer.values()) {
    for (const filePath of records.keys()) {
      filePaths.add(filePath);
    }
  }

  return [...filePaths]
    .sort((left, right) => left.localeCompare(right))
    .map((filePath) => buildRecord(filePath, recordsByAnalyzer));
}

function buildRecord(filePath, recordsByAnalyzer) {
  const codeIntent = recordsByAnalyzer.get("code-intent")?.get(filePath) || {};
  const triage = recordsByAnalyzer.get("agent-file-triage")?.get(filePath) || {};
  const blast = recordsByAnalyzer.get("rust-blast-radius")?.get(filePath) || {};
  const tests = recordsByAnalyzer.get("rust-test-coverage-intent")?.get(filePath) || {};

  const sourceRecords = {
    "agent-file-triage": selectFields(triage, [
      "triage_summary",
      "surface_area",
      "open_when",
      "answers_questions",
      "change_risk",
      "change_risk_reason",
    ]),
    "code-intent": selectFields(codeIntent, ["purpose", "parent_keywords", "mechanism"]),
    "rust-blast-radius": selectFields(blast, [
      "role",
      "dependents_count",
      "dependencies_count",
      "coupling_risk",
      "has_public_api",
      "change_risk",
    ]),
    "rust-test-coverage-intent": selectFields(tests, [
      "has_test",
      "test_role",
      "tested_behavior",
      "risk_covered",
      "add_test_guidance",
      "summary",
    ]),
  };

  const sourceAnalyzers = Object.entries(sourceRecords)
    .filter(([, record]) => Object.keys(record).length > 0)
    .map(([analyzer]) => analyzer)
    .sort();
  const sourceFingerprint = sha256(stableStringify(sourceRecords));

  return {
    file_path: filePath,
    fields: {
      read_md: renderReadMarkdown(codeIntent, triage, blast),
      edit_md: renderEditMarkdown(codeIntent, triage, blast, tests),
      source_analyzers: sourceAnalyzers,
      source_fingerprint: sourceFingerprint,
    },
  };
}

function renderReadMarkdown(codeIntent, triage, blast) {
  const sections = [];
  const purpose = firstString(triage.triage_summary, codeIntent.purpose, blast.purpose);
  if (purpose) {
    sections.push(`### What this file does\n\n${markdownText(purpose)}`);
  }

  const where = [];
  pushLabel(where, "Surface", firstString(triage.surface_area, blast.surface_area));
  pushLabel(where, "Role", firstString(blast.role));
  pushLabel(where, "Mechanism", firstString(codeIntent.mechanism));
  const topics = stringArray(codeIntent.parent_keywords).slice(0, 4);
  if (topics.length > 0) {
    pushLabel(where, "Areas", topics.map(titleCase).join(", "));
  }
  if (where.length > 0) {
    sections.push(`### Where it fits\n\n${where.join("\n")}`);
  }

  const openWhen = stringArray(triage.open_when).slice(0, 3);
  if (openWhen.length > 0) {
    sections.push(`### Useful when\n\n${bulletList(openWhen)}`);
  }
  return sections.join("\n\n");
}

function renderEditMarkdown(codeIntent, triage, blast, tests) {
  const sections = [];
  const purpose = firstString(triage.triage_summary, codeIntent.purpose, blast.purpose);
  if (purpose) {
    sections.push(`### What this file changes\n\n${markdownText(purpose)}`);
  }

  const risk = highestRisk(triage.change_risk, blast.change_risk, blast.coupling_risk);
  const impactFacts = [];
  if (risk) {
    impactFacts.push(`**${titleCase(risk)} risk**`);
  }
  if (blast.has_public_api === true) {
    impactFacts.push("Public API");
  } else if (blast.has_public_api === false) {
    impactFacts.push("Internal API");
  }
  const dependents = integerValue(blast.dependents_count);
  if (dependents !== null) {
    impactFacts.push(`${dependents} known dependent${dependents === 1 ? "" : "s"}`);
  }

  const impactLines = [];
  if (impactFacts.length > 0) {
    impactLines.push(impactFacts.join(" · "));
  }
  const riskReason = firstString(triage.change_risk_reason);
  if (riskReason) {
    impactLines.push(markdownText(riskReason));
  }
  if (impactLines.length > 0) {
    sections.push(`### Change impact\n\n${impactLines.join("\n\n")}`);
  }

  const safeguards = [];
  const testSummary = firstString(tests.summary);
  if (testSummary) {
    safeguards.push(markdownText(testSummary));
  }
  const risksCovered = stringArray(tests.risk_covered).slice(0, 4);
  if (risksCovered.length > 0) {
    safeguards.push(bulletList(risksCovered.map(titleCase)));
  }
  const testGuidance = firstString(tests.add_test_guidance);
  if (testGuidance) {
    safeguards.push(`**Test guidance:** ${markdownText(testGuidance)}`);
  }
  if (safeguards.length > 0) {
    sections.push(`### Tests and safeguards\n\n${safeguards.join("\n\n")}`);
  }
  return sections.join("\n\n");
}

function selectFields(record, names) {
  const selected = {};
  for (const name of names) {
    if (record[name] !== undefined && record[name] !== null && record[name] !== "N/A") {
      selected[name] = normalizeValue(record[name]);
    }
  }
  return selected;
}

function normalizeValue(value) {
  if (typeof value === "string") {
    const trimmed = value.trim();
    if ((trimmed.startsWith("[") && trimmed.endsWith("]")) || (trimmed.startsWith("{") && trimmed.endsWith("}"))) {
      try {
        return normalizeValue(JSON.parse(trimmed));
      } catch {
        return value;
      }
    }
    return value;
  }
  if (Array.isArray(value)) {
    return value.map(normalizeValue);
  }
  if (value && typeof value === "object") {
    return Object.fromEntries(
      Object.entries(value)
        .sort(([left], [right]) => left.localeCompare(right))
        .map(([key, item]) => [key, normalizeValue(item)]),
    );
  }
  return value;
}

function stringArray(value) {
  const normalized = normalizeValue(value);
  if (!Array.isArray(normalized)) {
    return [];
  }
  return [...new Set(normalized.filter((item) => typeof item === "string").map(cleanText).filter(Boolean))];
}

function firstString(...values) {
  for (const value of values) {
    if (typeof value === "string") {
      const cleaned = cleanText(value);
      if (cleaned && cleaned !== "N/A") {
        return cleaned;
      }
    }
  }
  return "";
}

function cleanText(value) {
  return String(value).replace(/\s+/g, " ").trim();
}

function markdownText(value) {
  return cleanText(value).replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");
}

function bulletList(values) {
  return values.map((value) => `- ${markdownText(value)}`).join("\n");
}

function pushLabel(lines, label, value) {
  if (value) {
    lines.push(`- **${label}:** ${markdownText(value)}`);
  }
}

function titleCase(value) {
  return cleanText(value)
    .replace(/[-_]+/g, " ")
    .replace(/\b\w/g, (character) => character.toUpperCase());
}

function integerValue(value) {
  return Number.isInteger(value) ? value : null;
}

function highestRisk(...values) {
  const rank = { low: 1, medium: 2, high: 3, critical: 4 };
  return values
    .filter((value) => typeof value === "string" && rank[value.toLowerCase()])
    .map((value) => value.toLowerCase())
    .sort((left, right) => rank[right] - rank[left])[0] || "";
}

function stableStringify(value) {
  if (Array.isArray(value)) {
    return `[${value.map(stableStringify).join(",")}]`;
  }
  if (value && typeof value === "object") {
    const entries = Object.entries(value).sort(([left], [right]) => left.localeCompare(right));
    return `{${entries.map(([key, item]) => `${JSON.stringify(key)}:${stableStringify(item)}`).join(",")}}`;
  }
  return JSON.stringify(value);
}

function sha256(value) {
  return createHash("sha256").update(value).digest("hex");
}

function normalizePath(filePath) {
  return filePath.replaceAll("\\", "/").replace(/^\.\//, "");
}

function writeJSONL(outputPath, records) {
  fs.mkdirSync(path.dirname(outputPath), { recursive: true });
  const body = records.map((record) => JSON.stringify(record)).join("\n");
  fs.writeFileSync(outputPath, body ? `${body}\n` : "", "utf8");
}

function filterChangedRecords(records, existing) {
  const changed = [];
  let newCount = 0;
  let changedCount = 0;
  let unchangedCount = 0;

  for (const record of records) {
    const previous = existing.get(record.file_path);
    if (!previous) {
      changed.push(record);
      newCount += 1;
      continue;
    }
    const previousFields = {
      read_md: typeof previous.read_md === "string" ? previous.read_md : "",
      edit_md: typeof previous.edit_md === "string" ? previous.edit_md : "",
      source_analyzers: stringArray(previous.source_analyzers).sort(),
      source_fingerprint:
        typeof previous.source_fingerprint === "string" ? previous.source_fingerprint : "",
    };
    if (sha256(stableStringify(record.fields)) === sha256(stableStringify(previousFields))) {
      unchangedCount += 1;
    } else {
      changed.push(record);
      changedCount += 1;
    }
  }
  return { records: changed, newCount, changedCount, unchangedCount };
}

function runAnalysisSet(repoRoot, bulkPath, context, flags) {
  const args = [
    "app",
    "analysis",
    "set",
    "--analyzer",
    TARGET_ANALYZER,
    "--bulk",
    bulkPath,
    ...contextArgs(context),
  ];
  if (flags.dryRun) {
    args.push("--dry-run");
  }
  if (flags.force) {
    args.push("--force");
  }

  const result = spawnSync("gsc", args, {
    cwd: repoRoot,
    encoding: "utf8",
    stdio: ["ignore", "inherit", "inherit"],
  });
  if (result.error) {
    throw new Error(`Failed to run gsc: ${result.error.message}`);
  }
  if (result.status !== 0) {
    throw new Error(`gsc app analysis set failed with exit code ${result.status}`);
  }
}

function contextArgs(context) {
  return ["--owner", context.owner, "--repo", context.repo, "--branch", context.branch];
}

function runSelfTest() {
  const records = new Map([
    [
      "code-intent",
      new Map([
        [
          "src/example.rs",
          {
            purpose: "Modify this file to change JSON output.",
            parent_keywords: ["serialization", "public-api"],
            mechanism: "json-lines",
          },
        ],
      ]),
    ],
    [
      "agent-file-triage",
      new Map([
        [
          "src/example.rs",
          {
            triage_summary: "Implements the public JSON Lines output format.",
            surface_area: "primary-implementation",
            open_when: ["Changing JSON output", "Debugging binary encoding"],
            change_risk: "high",
            change_risk_reason: "Downstream tools parse this output.",
          },
        ],
      ]),
    ],
    [
      "rust-blast-radius",
      new Map([
        [
          "src/example.rs",
          {
            role: "defines-api",
            dependents_count: 3,
            coupling_risk: "high",
            has_public_api: true,
          },
        ],
      ]),
    ],
    [
      "rust-test-coverage-intent",
      new Map([
        [
          "src/example.rs",
          {
            summary: "Tests cover JSON events and binary detection.",
            risk_covered: ["json-format-regression", "binary-detection-regression"],
            add_test_guidance: "Add output compatibility tests here.",
          },
        ],
      ]),
    ],
  ]);
  const [record] = buildRecords(records);
  assert(record.file_path === "src/example.rs", "file path");
  assert(record.fields.read_md.includes("### What this file does"), "read purpose heading");
  assert(record.fields.read_md.includes("### Useful when"), "read guidance heading");
  assert(record.fields.edit_md.includes("**High risk** · Public API · 3 known dependents"), "risk summary");
  assert(record.fields.edit_md.includes("### Tests and safeguards"), "test heading");
  assert(record.fields.source_fingerprint.length === 64, "source fingerprint");
  process.stdout.write("session-review self-test passed\n");
}

function assert(condition, label) {
  if (!condition) {
    throw new Error(`Self-test failed: ${label}`);
  }
}

try {
  main();
} catch (error) {
  process.stderr.write(`${error instanceof Error ? error.message : String(error)}\n`);
  process.exitCode = 1;
}
